{
  "name": "dweb-hosting-network",
  "private": true,
  "version": "0.1.0",
  "description": "Modular workspace for the DWeb Hosting Network project",
  "packageManager": "npm@10.5.0",
  "workspaces": [
    "backend/*",
    "extension"
  ],
  "scripts": {
    "lint": "echo \"No lint configuration yet\"",
    "test": "node tools/comprehensive-test-runner.js",
    "dev": "echo \"Use workspace scripts\"",
    "test:e2e": "node tools/e2e-tests.js",
    "test:p2p": "node tools/test-p2p-two-browsers.js",
    "test:comprehensive": "node tools/comprehensive-test-runner.js",
    "test:quick": "node tools/quick-test.js",
    "test:workflow": "node tools/test-full-workflow.js",
    "demo:architecture": "node tools/demo-current-architecture.js",
    "setup:extension": "node tools/setup-extension.js",
    "fix:domain-replicas": "node tools/fix-domain-replicas.js",
    "setup:production": "node tools/production-setup.js",
    "deploy:prod": "docker-compose -f docker-compose.prod.yml up -d"
  },
  "devDependencies": {
    "playwright": "^1.40.0",
    "chrome-remote-interface": "^0.32.0"
  }
}
